<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Arch">
            <directory>tests/Arch</directory>
        </testsuite>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Migrations">
            <directory>tests/Migrations</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <!-- Every value is forced. In the containers .env also arrives as real environment
         variables (Compose env_file), which Laravel reads from $_SERVER first; force="true"
         alone doesn't reach $_SERVER, so tests/bootstrap.php copies these values there and
         refuses to run unless DB_DATABASE is edqa_test. RefreshDatabase must never touch the
         development database. Postgres only, never SQLite (CLAUDE.md hard rule 4). -->
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="edqa_test" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="EDQA_REQUIRE_2FA" value="true" force="true"/>
        <!-- The developer's .env may hold real source credentials (Kobo credentials day): tests never
             see them, so no test can reach a real server. A test that needs a source sets config(). -->
        <env name="ODK_CENTRAL_URL" value="" force="true"/>
        <env name="ODK_CENTRAL_EMAIL" value="" force="true"/>
        <env name="ODK_CENTRAL_PASSWORD" value="" force="true"/>
        <env name="ODK_PROJECT_ID" value="" force="true"/>
        <env name="ODK_FORM_ID" value="" force="true"/>
        <env name="ODK_WEBHOOK_SECRET" value="" force="true"/>
        <env name="ODK_ALLOW_INSECURE_LOCAL" value="" force="true"/>
        <env name="ODK_ENABLED" value="" force="true"/>
        <env name="KOBO_BASE_URL" value="" force="true"/>
        <env name="KOBO_API_TOKEN" value="" force="true"/>
        <env name="KOBO_ASSET_UID" value="" force="true"/>
        <env name="KOBO_WEBHOOK_TOKEN" value="" force="true"/>
        <env name="KOBO_ALLOW_INSECURE_LOCAL" value="" force="true"/>
        <env name="KOBO_ENABLED" value="" force="true"/>
        <env name="HEARTBEAT_PULL_ODK_URL" value="" force="true"/>
        <env name="HEARTBEAT_PULL_KOBO_URL" value="" force="true"/>
        <env name="HEARTBEAT_ODK_PULL_URL" value="" force="true"/>
        <env name="HEARTBEAT_SCHEDULER_URL" value="" force="true"/>
    </php>
</phpunit>
