# Kaduna eDQA — every key the servers set (DEPLOY.md §15.2). Values here suit local
# development in compose.dev.yml; hosts are Compose service names, never localhost.

APP_NAME="Kaduna eDQA"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_KEY=
APP_PREVIOUS_KEYS=
APP_TIMEZONE=Africa/Lagos
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=debug
LOG_STDERR_FORMATTER=
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=edqa
DB_USERNAME=edqa_app
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

QUEUE_CONNECTION=redis
CACHE_STORE=redis

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

ODK_CENTRAL_URL=
ODK_CENTRAL_EMAIL=
ODK_CENTRAL_PASSWORD=
ODK_PROJECT_ID=
ODK_FORM_ID=
ODK_WEBHOOK_SECRET=
ODK_PULL_PAGE_SIZE=
ODK_BACKFILL_THROTTLE=

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
EDQA_DIGEST_RECIPIENTS=

BROWSERSHOT_CHROME_PATH=
BROWSERSHOT_NODE_BINARY=
HEARTBEAT_ODK_PULL_URL=
HEARTBEAT_SCHEDULER_URL=

VITE_APP_NAME="${APP_NAME}"
