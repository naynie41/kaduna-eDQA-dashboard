# Copy to discovery/.env (git-ignored) and fill in. Use a read-only ODK Central account if one exists.
ODK_CENTRAL_URL=https://odk.example.org
ODK_CENTRAL_EMAIL=
ODK_CENTRAL_PASSWORD=
ODK_PROJECT_ID=
ODK_FORM_ID=

# Seconds to sleep between paged requests
ODK_THROTTLE_SECONDS=1

# KoboToolbox (kobo_inventory.py, kobo_forms.py). The API token of an account that can only view
# the asset; never an owner's. Or run the Kobo tools with --offline fixtures/kobo.
# Leave KOBO_ASSET_UID empty at first: kobo_inventory.py then lists the assets the token can see.
KOBO_BASE_URL=https://kf.kobotoolbox.org
KOBO_API_TOKEN=
KOBO_ASSET_UID=
KOBO_THROTTLE_SECONDS=1
